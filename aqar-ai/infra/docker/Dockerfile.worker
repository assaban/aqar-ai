# ============================================
# Aqar.ai - Pipeline Worker Dockerfile
# ============================================
# Includes FFmpeg for audio extraction
# ============================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System dependencies including FFmpeg for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy full source first, then install
COPY packages/db/ packages/db/
COPY packages/pipeline/ packages/pipeline/
COPY apps/api/ apps/api/

RUN pip install -e packages/db && \
    pip install -e "packages/pipeline[dev]" && \
    pip install -e apps/api

# Create download directory
RUN mkdir -p /tmp/aqar/downloads

# Non-root user
RUN adduser --disabled-password --gecos '' worker
RUN chown -R worker:worker /tmp/aqar
USER worker

CMD ["celery", "-A", "packages.pipeline.aqar_pipeline.celery_app", "worker", \
     "--loglevel=info", "--concurrency=2"]
