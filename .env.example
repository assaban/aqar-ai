# ============================================
# Aqar.ai - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# ── Application ──
APP_NAME=aqar-ai
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-to-a-random-string-in-production

# ── Database (PostgreSQL + PostGIS) ──
POSTGRES_USER=aqar
POSTGRES_PASSWORD=aqar_dev_password
POSTGRES_DB=aqar_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ── Celery (Task Queue) ──
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ── Meilisearch ──
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700
MEILISEARCH_URL=http://${MEILISEARCH_HOST}:${MEILISEARCH_PORT}
MEILISEARCH_MASTER_KEY=aqar_meili_dev_key

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                # Increase in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── AI/ML Pipeline ──
# OpenAI Whisper
WHISPER_MODEL=base               # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu               # cpu | cuda
WHISPER_LANGUAGE=ar              # Arabic language hint

# LLM Extraction (Strategy Pattern: ollama | openai | anthropic)
LLM_PROVIDER=ollama              # Default provider
PROMPT_VERSION=v1                # Prompt template version
EXTRACTION_CONFIDENCE_THRESHOLD=0.6

# Ollama (Primary: local inference)
OLLAMA_MODEL=gemma3              # gemma3 | gemma3:27b | gemma4
OLLAMA_BASE_URL=http://ollama:11434

# OpenAI (Secondary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini        # gpt-4o | gpt-4o-mini

# Anthropic Claude (Tertiary)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Geocoding ──
GEOCODING_PROVIDER=nominatim  # nominatim | google
GOOGLE_MAPS_API_KEY=          # Required if provider=google
NOMINATIM_USER_AGENT=aqar-ai-dev

# ── Video Ingestion ──
YOUTUBE_API_KEY=              # Optional: for official API (higher rate limits)
MAX_VIDEO_DURATION_MINUTES=30 # Skip videos longer than this
DOWNLOAD_PATH=/tmp/aqar/downloads
AUDIO_FORMAT=wav              # wav | mp3

# ── Web Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_KEY=aqar_meili_dev_key
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# ── Monitoring (Optional) ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
